// Reverse Array in-place (Two Pointers)
// 7 6 5 4 3 2 1
from std.io import put

func main() {
    var a = [1 2 3 4 5 6 7]
    const n = 7

    var left = 0
    var right = n - 1

    while left < right {
        const tmp = a[left]
        a[left] = a[right]
        a[right] = tmp

        left += 1
        right -= 1
    }

    for i in 0..n {
        put(f"{a[i]} ")
    }
    put("\n")
}
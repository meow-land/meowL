// Bubble Sort
// 11 12 22 25 34 64 90
from std.io import put

func main() {
    var a = [64 34 25 12 22 11 90]
    const n = 7

    for i in 0..n {
        for j in 0..(n - i - 1) {
            if a[j] > a[j + 1] {
                const tmp = a[j]
                a[j] = a[j + 1]
                a[j + 1] = tmp
            }
        }
    }

    for i in 0..n {
        put(f"{a[i]} ")
    }
    put("\n")
}
